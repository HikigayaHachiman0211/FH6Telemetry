<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:FH6Telemetry"
             xmlns:loc="using:FH6Telemetry.Views"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="FH6Telemetry.AboutView"
             x:DataType="app:AboutViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10">
            <Border Classes="hero-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Image Width="48" Height="48" Source="/Assets/FH6Telemetry.png" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{loc:Tr AppTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding VersionText}" Classes="subtle" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="primary" VerticalAlignment="Center"
                                Content="{loc:Tr AboutCheck}" Command="{Binding CheckForUpdatesCommand}" />
                    </Grid>
                    <TextBlock Text="{loc:Tr AboutRepositoryMissing}" Classes="subtle" TextWrapping="Wrap"
                               IsVisible="{Binding !HasRepository}" />
                    <TextBlock Text="{Binding UpdateStatus}" Classes="subtle" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               IsVisible="{Binding UpdateStatus, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
                    <Button Classes="ghost-sm" Content="{loc:Tr AboutOpenUpdates}" HorizontalAlignment="Left"
                            IsVisible="{Binding ShowUpdatesFolder}" Command="{Binding OpenUpdatesFolderCommand}" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Tr AboutAutoDownload}" Classes="h3" />
                            <TextBlock Text="{loc:Tr AboutAutoDownloadHint}" Classes="subtle" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                      AutomationProperties.Name="{loc:Tr AboutAutoDownload}" IsEnabled="{Binding HasRepository}"
                                      IsChecked="{Binding AutoDownloadUpdates, Mode=TwoWay}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource CardBorder}" />
                    <WrapPanel ItemSpacing="8" LineSpacing="4" IsEnabled="{Binding HasRepository}">
                        <HyperlinkButton Content="{loc:Tr AboutProject}" NavigateUri="{Binding ProjectPage}" />
                        <HyperlinkButton x:Name="AboutGuideLink" Content="{loc:Tr AboutUserGuide}" NavigateUri="{Binding UserGuidePage}" />
                        <HyperlinkButton Content="{loc:Tr AboutChangelog}" NavigateUri="{Binding ReleasesPage}" />
                        <HyperlinkButton Content="{loc:Tr AboutLatest}" NavigateUri="{Binding LatestReleasePage}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding ShowStarPrompt}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                    <TextBlock Text="★" FontSize="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{loc:Tr AboutStarPrompt}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <HyperlinkButton Grid.Column="2" VerticalAlignment="Center"
                                     Content="{loc:Tr AboutStarLink}" NavigateUri="{Binding ProjectPage}" />
                    <Button Grid.Column="3" Classes="ghost-sm" VerticalAlignment="Center" Content="×"
                            ToolTip.Tip="{loc:Tr AboutDismissStar}" AutomationProperties.Name="{loc:Tr AboutDismissStar}"
                            Command="{Binding DismissStarPromptCommand}" />
                </Grid>
            </Border>

            <TextBlock Classes="dim" Text="GPL-3.0" Margin="2,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
