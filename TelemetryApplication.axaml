<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FH6Telemetry.TelemetryApplication"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#0D1523" />
        <SolidColorBrush x:Key="CardBackground" Color="#151F30" />
        <SolidColorBrush x:Key="CardBorder" Color="#2A3951" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FFB565" />
        <SolidColorBrush x:Key="TextPrimary" Color="#EEF3FA" />
        <SolidColorBrush x:Key="TextSecondary" Color="#B4C2D6" />
        <SolidColorBrush x:Key="TextDim" Color="#98ABC5" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource WindowBackground}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Yu Gothic UI, Malgun Gothic, Inter, $Default" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.h3">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.subtle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.dim">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        </Style>
        <Style Selector="TextBlock.section-header">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#9CC8F8" />
        </Style>
        <Style Selector="Border.card, Border.hero-card">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Border.hero-card">
            <Setter Property="BorderBrush" Value="#5B4535" />
            <Setter Property="Padding" Value="18,16" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#182133" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFD09D" />
            <Setter Property="Foreground" Value="#182133" />
        </Style>
        <Style Selector="Button.ghost, Button.ghost-sm">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.ghost-sm">
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="9,8" />
        </Style>
    </Application.Styles>
</Application>
